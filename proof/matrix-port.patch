+                        .as_nanos(),
+                )
+                .unwrap_or(u64::MAX)
+            };
+            options
+                .set_connect_timeout(Some(timeout(2)))
+                .map_err(|_| "matrix: HTTP timeout refused")?;
+            options
+                .set_first_byte_timeout(Some(timeout(3)))
+                .map_err(|_| "matrix: HTTP timeout refused")?;
+            options
+                .set_between_bytes_timeout(Some(timeout(1)))
+                .map_err(|_| "matrix: HTTP timeout refused")?;
