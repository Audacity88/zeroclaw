+fn departures_free_metadata_capacity_before_additions_and_reject_malformed_entries() {
+    let config = cfg();
+    let mut state = Session::new(&config, SELF.into());
+    let joined: serde_json::Map<String, Value> = (0..MAX_ROOM_METADATA)
+        .map(|i| {
+            (
