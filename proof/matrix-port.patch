+                        .map_err(|_| "matrix: HTTP write failed")?;
+                    offset += size;
+                }
+                stream.flush().map_err(|_| "matrix: HTTP flush failed")?;
+                loop {
+                    budget.remaining()?;
+                    if stream
+                        .check_write()
+                        .map_err(|_| "matrix: HTTP flush failed")?
