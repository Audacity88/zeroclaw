+            let status = response.status();
+            let incoming = response
+                .consume()
+                .map_err(|()| "matrix: HTTP response unavailable")?;
+            let stream = incoming
+                .stream()
+                .map_err(|()| "matrix: HTTP input unavailable")?;
+            let mut bytes = Vec::new();
+            loop {
