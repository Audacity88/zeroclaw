+                        .check_write()
+                        .map_err(|_| "matrix: HTTP write failed")?;
+                    let size = (bytes.len() - offset).min(4096).min(quota as usize);
+                    if size == 0 {
+                        budget.wait(&stream.subscribe())?;
+                        continue;
+                    }
+                    stream
