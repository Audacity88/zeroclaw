+                        .map_err(|()| "matrix: HTTP completion already taken")?
+                        .map_err(|_| "matrix: HTTP response incomplete")?;
+                    drop(trailers);
+                    break;
+                }
+                budget.wait(&completion.subscribe())?;
+            }
+            Ok((status, bytes))
+        }
